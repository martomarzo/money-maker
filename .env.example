# Postgres connection string used by the app. Host must be `postgres`
# (the compose service name) since the app shares the tailscale
# container's network namespace.
DATABASE_URL=postgres://money:changeme@postgres:5432/money_maker

POSTGRES_USER=money
POSTGRES_PASSWORD=changeme
POSTGRES_DB=money_maker

# generate with `openssl rand -base64 32`
AUTH_SECRET=

AUTH_URL=https://money-maker.YOUR-TAILNET.ts.net

# one-time Tailscale auth key for first enrollment, from
# https://login.tailscale.com/admin/settings/keys; can be removed after
# first start
TS_AUTHKEY=
